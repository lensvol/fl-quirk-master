{
  "name": "FL Quirk Master",
  "description": "Annotate branches which influence your Quirks.",
  "version": "1.1.1",
  "manifest_version": 3,
  "host_permissions": ["https://www.fallenlondon.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.fallenlondon.com/*"],
      "js": ["quirk_changes.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_icon": {
      "16": "/images/fl-quirk-master-icon-16.png",
      "32": "/images/fl-quirk-master-icon-32.png",
      "48": "/images/fl-quirk-master-icon-48.png",
      "128": "/images/fl-quirk-master-icon-128.png"
    }
  },
  "icons": {
    "16": "/images/fl-quirk-master-icon-16.png",
    "32": "/images/fl-quirk-master-icon-32.png",
    "48": "/images/fl-quirk-master-icon-48.png",
    "128": "/images/fl-quirk-master-icon-128.png"
  },
  "web_accessible_resources": [],
  "browser_specific_settings": {
    "gecko": {
      "id": "{55172e79-76f3-4620-8c32-5c89d2e09e73}",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
